#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
/*           ┌─────────┬─────────┬─────────┬─────────┬─────────┐    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │    Q    │    W    │    E    │    R    │    T    │    │    Y    │    U    │    I    │    O    │    P    │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │  SHIFT  │    A    │    S    │    D    │    F    │    G    │    │    H    │    J    │    K    │    L    │    ;    │  SHIFT  │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │   CMD   │    Z    │    X    │    C    │    V    │    B    │    │    N    │    M    │    ,    │    .    │    /    │   CMD   │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │   ESC   │  SPACE  │   TAB   │    │  ENTER  │  BSPCE  │   DEL   │
                                 └─────────┴─────────┴─────────┘    └─────────┴─────────┴─────────┘ */
            bindings = <
// │         │         │         │         │         │         │    │         │         │         │         │         │         │

              &kp Q     &kp W     &kp E     &kp R     &kp T          &kp Y     &kp U     &kp I     &kp O     &kp P
    &kp LSHFT &kp A     &kp S     &kp D     &kp F     &kp G          &kp H     &kp N     &kp E     &kp I     &kp O     &kp RSHFT
    &kp LCMD  &kp Z     &kp X     &kp C     &kp V     &kp B          &kp K     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RCMD
                                  &kp ESC   &kp SPACE &kp TAB        &kp RET   &kp BSPC  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };
    };
 };
