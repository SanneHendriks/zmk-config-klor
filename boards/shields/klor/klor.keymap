#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include "klor-key-labels.h"

#define BASE  0
#define NAV   1
#define MOUSE 2
#define NUM   3
#define SYM   4
#define FUN   5
#define LOCK  6

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
        btclrhold: bluetooth_clear_on_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <1000>;
            flavor = "tap-preferred";
            bindings = <&btclr_marco>, <&none>;
        };
        bt0hold: bluetooth_profile_0_on_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <1000>;
            flavor = "tap-preferred";
            bindings = <&bt0_marco>, <&none>;
        };
        bt1hold: bluetooth_profile_1_on_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <1000>;
            flavor = "tap-preferred";
            bindings = <&bt1_marco>, <&none>;
        };
    };

    macros {
        siri: activate_siri {
            compatible = "zmk,behavior-macro";
            tap-ms = <1000>;
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
        };
        btclr_marco: bluetooth_clear_marco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR_ALL>;
        };
        bt0_marco: bluetooth_profile_0_marco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;
        };
        bt1_marco: bluetooth_profile_1_marco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
//           ┌─────────┬─────────┬─────────┬─────────┬─────────┐    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              &kp Q     &kp W     &kp E     &kp R     &kp T          &kp Y     &kp U     &kp I     &kp O     &kp P
// ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    &kp LSHFT &kp A &hml LCTRL S &hml LALT D &hml LCMD F &kp G    &kp H &hmr RCMD J &hmr RALT K &hmr RCTRL L &kp SEMI  &kp RSHFT
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &kp LCMD  &kp Z     &kp X     &kp C     &kp V     &kp B          &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RCMD
// └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                        &lt FUN ESC &lt NAV SPACE &lt MOUSE TAB      &lt SYM RET &lt NUM BSPC &lt FUN DEL
//                               └─────────┴─────────┴─────────┘    └─────────┴─────────┴─────────┘
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP &inc_dec_kp RIGHT LEFT>;
        };

        nav_layer {
            bindings = <
//           ┌─────────┬─────────┬─────────┬─────────┬─────────┐    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              &none     &none     &none     &none     &none      &kp RG(RS(Z)) &kp RG(V) &kp RG(C) &kp RG(X) &kp RG(Z)
// ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    &trans    &none     &kp LCTRL &kp LALT  &kp LCMD  &none          &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &caps_word &trans
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &trans    &none     &none     &none     &none     &none          &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp INS   &trans
// └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                  &trans    &to BASE  &trans         &trans    &trans    &trans
//                               └─────────┴─────────┴─────────┘    └─────────┴─────────┴─────────┘
            >;
        };

        mouse_layer {
            bindings = <
//           ┌─────────┬─────────┬─────────┬─────────┬─────────┐    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              &none     &none     &none     &none     &none          &mkp MB5  &kp RG(V) &kp RG(C) &kp RG(X) &mkp MB4
// ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    &trans    &none     &kp LCTRL &kp LALT  &kp LCMD  &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none &trans
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &trans    &none     &none     &none     &none     &none &msc SCRL_RIGHT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_LEFT &none &trans
// └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                  &trans    &trans    &to BASE       &mkp MB2  &mkp MB1  &mkp MB3
//                               └─────────┴─────────┴─────────┘    └─────────┴─────────┴─────────┘
            >;
        };

        num_layer {
            bindings = <
//           ┌─────────┬─────────┬─────────┬─────────┬─────────┐    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              &kp LBKT  &kp N7    &kp N8    &kp N9    &kp RBKT   &kp RG(RS(Z)) &kp RG(V) &kp RG(C) &kp RG(X) &kp RG(Z)
// ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    &trans    &kp SQT   &kp N4    &kp N5    &kp N6    &kp EQUAL      &none     &kp RCMD  &kp RALT  &kp RCTRL &none     &trans
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &trans    &kp GRAVE &kp N1    &kp N2    &kp N3    &kp BSLH       &none     &none     &none     &none     &none     &trans
// └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                  &kp DOT   &kp N0    &kp MINUS      &trans    &to BASE  &trans
//                               └─────────┴─────────┴─────────┘    └─────────┴─────────┴─────────┘
            >;
        };

        sym_layer {
            bindings = <
//           ┌─────────┬─────────┬─────────┬─────────┬─────────┐    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              &kp LBRC  &kp AMPS  &kp ASTRK &kp LPAR  &kp RBRC   &kp RG(RS(Z)) &kp RG(V) &kp RG(C) &kp RG(X) &kp RG(Z)
// ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    &trans    &kp DQT   &kp DLLR  &kp PRCNT &kp CARET &kp PLUS       &none     &kp RCMD  &kp RALT  &kp RCTRL &none     &trans
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &trans    &kp TILDE &kp EXCL  &kp AT    &kp HASH  &kp PIPE       &none     &none     &none     &none     &none     &trans
// └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                  &kp LPAR  &kp RPAR  &kp UNDER      &to BASE  &trans    &trans
//                               └─────────┴─────────┴─────────┘    └─────────┴─────────┴─────────┘
            >;
        };

        fun_layer {
            bindings = <
//              ┌────────────┬────────────┬────────────┬────────────┬────────────┐    ┌────────────┬────────────┬────────────┬────────────┬────────────┐
                 &kp F12      &kp F7       &kp F8       &kp F9       &kp LS(LG(N5))  &kp C_BRI_DEC &kp C_BRI_INC &rgb_ug RGB_BRD &rgb_ug RGB_BRI &btclrhold 0 0
// ┌────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤    ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┐
    &kp LC(LG(Q)) &kp F11     &kp F4       &kp F5       &kp F6       &kp LG(SPACE)     &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP     &bt1hold 0 0 &kp RC(RG(Q))
// ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤    ├────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤
    &mt GLOBE LC(LG(SPACE)) &kp F10 &kp F1 &kp F2       &kp F3       &siri             &kp RC(LEFT) &kp RC(DOWN) &kp RC(UP)  &kp RC(RIGHT) &bt0hold 0 0 &sl LOCK
// └────────────┴────────────┴────────────┼────────────┼────────────┼────────────┤    ├────────────┼────────────┼────────────┼────────────┴────────────┴────────────┘
                                           &to BASE     &trans       &trans            &trans       &trans       &to BASE
//                                        └────────────┴────────────┴────────────┘    └────────────┴────────────┴────────────┘
            >;
        };

        lock_layer {
            bindings = <
//           ┌─────────┬─────────┬─────────┬─────────┬─────────┐    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              &to BASE  &to BASE  &to BASE  &to BASE  &to BASE       &to BASE  &to BASE  &to BASE  &to BASE  &to BASE
// ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    &to BASE  &to BASE  &to BASE  &to BASE  &to BASE  &to BASE       &to BASE  &to BASE  &to BASE  &to BASE  &to BASE  &to BASE
// ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &to BASE  &to BASE  &to BASE  &to BASE  &to BASE  &to BASE       &to BASE  &to BASE  &to BASE  &to BASE  &to BASE  &to BASE
// └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤    ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                  &to FUN   &to NAV   &to MOUSE      &to SYM   &to NUM   &to FUN
//                               └─────────┴─────────┴─────────┘    └─────────┴─────────┴─────────┘
            >;
        };
    };
 };
